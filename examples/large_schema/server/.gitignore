# Files and directories created by pub
.dart_tool/
.packages

# Conventional directory for build outputs
build/

# Ignore the flutter web app directory
web/app

# Generated Cloud model-source payload; rebuilt before every deployment.
assets/lens-models/

# Directory created by dartdoc
doc/api/

# Passwords file
config/passwords.yaml

# Firebase service account key for Firebase auth
config/firebase_service_account_key.json

# Embedded PostgreSQL runtime artifacts (data dir, sockets, pidfiles)
.serverpod/

# SQLite databases created by the ephemeral test database
**/sp_*.db*
